# Public site URL used by metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Supabase-backed CMS, contact inbox, media library, and leaderboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: /admin authentication. ADMIN_TOTP_SECRET must be base32 encoded.
ADMIN_TOTP_SECRET=
JWT_SECRET=

# Optional: Vercel AI Gateway portfolio assistant.
AI_GATEWAY_API_KEY=

# Optional: contact-form email delivery.
RESEND_API_KEY=
